NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false

# Optional production-grade contact abuse controls.
# If omitted, a documented per-instance in-memory fallback is used.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_standard_server_only_token

# Optional notification after a contact message is persisted successfully.
RESEND_API_KEY=re_your_server_only_key
CONTACT_NOTIFICATION_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-verified-domain.com>
